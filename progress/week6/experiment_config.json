{
  "case_study": "real_execution_trace_guided_admission_gating",
  "controlled_workload": "tool_resume_contention_meso",
  "settings": [
    "default_vllm",
    "critical_path_aware"
  ],
  "repetitions_per_setting": 5,
  "runtime": {
    "backend": "vLLM OpenAI-compatible streaming",
    "model": "Qwen3.5-4B",
    "served_model_name": "local-mas-model",
    "gpu": "NVIDIA RTX A6000",
    "gpu_count": 1,
    "tensor_parallel_size": 1,
    "max_model_len": 8192,
    "max_concurrent_llm_calls": 8
  },
  "tools": {
    "mode": "live",
    "provider": "tavily",
    "synthetic_fallback_allowed": false,
    "record_tool_results": true
  },
  "controlled_workload_shape": {
    "tool_branch_width": 4,
    "planner_max_output_tokens": 96,
    "critical_coder_max_output_tokens": 128,
    "critical_reviewer_max_output_tokens": 512,
    "critical_finalizer_max_output_tokens": 128,
    "pre_tool_agent_max_output_tokens": 96,
    "tool_resume_max_output_tokens": 256,
    "evidence_merge_max_output_tokens": 128
  },
  "admission": {
    "maximum_defer_seconds": 30,
    "oracle_trace_used": false,
    "future_arrival_prediction_used": false,
    "future_output_length_prediction_used": false,
    "post_hoc_actual_critical_path_used": false
  },
  "observation": {
    "llm_timing": "OpenAI SSE chunk timestamps plus backend token usage",
    "backend_metrics_interval_seconds": 0.1,
    "kernel_level_overlap_claimed": false
  },
  "secrets": "TAVILY_API_KEY is loaded from ignored .env and is not stored here."
}
