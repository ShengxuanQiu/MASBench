diff --git a/vllm/mas_trace.py b/vllm/mas_trace.py
index 1d7caf5ca..c3ee8f950 100644
--- a/vllm/mas_trace.py
+++ b/vllm/mas_trace.py
@@ -74,6 +74,66 @@ def summarize_scheduler_output(scheduler_output: Any) -> dict[str, Any]:
     }
 
 
+def summarize_request_phases(
+    requests: dict[str, Any], scheduler_output: Any
+) -> dict[str, Any]:
+    """Split scheduled tokens into prompt-prefill and decode work.
+
+    This snapshot must be taken before Scheduler._update_after_schedule mutates
+    request.num_computed_tokens. The resulting counts describe scheduler work,
+    not inferred HTTP request overlap and not CUDA kernel occupancy.
+    """
+    scheduled = dict(getattr(scheduler_output, "num_scheduled_tokens", {}))
+    new_request_ids = {
+        str(req.req_id) for req in getattr(scheduler_output, "scheduled_new_reqs", [])
+    }
+    details: dict[str, dict[str, Any]] = {}
+    prefill_by_request: dict[str, int] = {}
+    decode_by_request: dict[str, int] = {}
+    cached_prefix_by_request: dict[str, int] = {}
+    for req_id, raw_count in scheduled.items():
+        request = requests.get(req_id)
+        if request is None:
+            continue
+        count = int(raw_count)
+        prompt_tokens = int(getattr(request, "num_prompt_tokens", 0) or 0)
+        computed_before = int(getattr(request, "num_computed_tokens", 0) or 0)
+        remaining_prompt = max(0, prompt_tokens - computed_before)
+        prefill_tokens = min(count, remaining_prompt)
+        decode_tokens = max(0, count - prefill_tokens)
+        if prefill_tokens and decode_tokens:
+            phase = "mixed"
+        elif prefill_tokens:
+            phase = "prefill"
+        else:
+            phase = "decode"
+        first_schedule = req_id in new_request_ids
+        cached_prefix_tokens = computed_before if first_schedule else None
+        details[str(req_id)] = {
+            "phase": phase,
+            "scheduled_tokens": count,
+            "prefill_tokens": prefill_tokens,
+            "decode_tokens": decode_tokens,
+            "prompt_tokens": prompt_tokens,
+            "computed_tokens_before": computed_before,
+            "first_schedule": first_schedule,
+            "cached_prefix_tokens": cached_prefix_tokens,
+        }
+        prefill_by_request[str(req_id)] = prefill_tokens
+        decode_by_request[str(req_id)] = decode_tokens
+        if cached_prefix_tokens is not None:
+            cached_prefix_by_request[str(req_id)] = cached_prefix_tokens
+    return {
+        "request_phase_details": details,
+        "prefill_tokens_by_request": prefill_by_request,
+        "decode_tokens_by_request": decode_by_request,
+        "cached_prefix_tokens_by_request": cached_prefix_by_request,
+        "total_prefill_tokens": sum(prefill_by_request.values()),
+        "total_decode_tokens": sum(decode_by_request.values()),
+        "phase_evidence_scope": "vllm_scheduler_step",
+    }
+
+
 def summarize_kv_event(event: Any) -> dict[str, Any]:
     name = type(event).__name__
     block_hashes = getattr(event, "block_hashes", None)
